# Settle frontend env — copy to frontend/.env.local

# Where the browser sends API calls. Default "/api/v1" goes through the Next.js
# proxy (next.config.ts), which avoids CORS because the Go API sends no CORS headers.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the Next.js proxy forwards /api/v1/* (server side).
API_PROXY_TARGET=http://localhost:8080
