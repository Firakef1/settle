# Backend local env — copy to backend/.env

# The environment the application is running in (e.g., development, production)
APP_ENV=development

# The port the HTTP server binds to
HTTP_PORT=8080

# The PostgreSQL database connection string
DATABASE_URL=postgres://settle:settle@localhost:5432/settle?sslmode=disable

# Authentication & Security
# -------------------------
# The secret key used to cryptographically sign JWT tokens
SECRET_KEY=change-me-in-dev

# How long an access token is valid for before requiring a refresh
ACCESS_TOKEN_TTL=24h

# How long a refresh token is valid for before requiring re-login
REFRESH_TOKEN_TTL=720h

# Secret key used for HMAC SHA256 hashing of password reset OTPs
PASSWORD_RESET_SECRET=some-secret-key-for-password-resets

# How long a password reset OTP is valid for
PASSWORD_RESET_OTP_TTL=15m

# The maximum number of failed attempts allowed for a single password reset OTP
PASSWORD_RESET_MAX_ATTEMPTS=5

# Email & SMTP Configuration
# --------------------------
# Set to "true" to only log emails to stdout (useful for local dev). Set to "false" to send them via SMTP.
EMAIL_LOG_ONLY=true

# Secret used to sign email verification codes (must be >= 32 characters)
EMAIL_CODE_SECRET=settle_default_email_code_secret_at_least_32_chars

# How long an email verification code is valid for
EMAIL_CODE_TTL=15m

# Maximum time to wait for the SMTP server to send an email before timing out
EMAIL_SEND_TIMEOUT=10s

# The hostname of the SMTP server
SMTP_HOST=smtp.mailtrap.io

# The port of the SMTP server
SMTP_PORT=2525

# The username to authenticate with the SMTP server
SMTP_USERNAME=your_username

# The password to authenticate with the SMTP server
SMTP_PASSWORD=your_password

# The address emails will be sent from (e.g., noreply@yourdomain.com)
EMAIL_FROM_ADDRESS=noreply@settle.com

# The friendly name attached to outgoing emails
EMAIL_FROM_NAME=Settle

# Storage & Receipts
# ------------------
# The local directory where uploaded receipt files are stored before processing
UPLOAD_DIR=./uploads

# Your API key for the free OCR.Space API (used for background OCR parsing)
# use api from "https://ocr.space/"
OCR_API_KEY=helloworld

# Sign in with Google / Microsoft (OAuth 2.0)
# ------------------------------------------
# A provider is enabled only when both its client ID and secret are set; the
# login/signup pages hide buttons for providers that aren't configured.
# Register this redirect URI with each provider:
#   <OAUTH_PUBLIC_BASE_URL>/api/v1/auth/oauth/<google|microsoft>/callback
#   e.g. http://localhost:3000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows work/school and personal Microsoft accounts.
MICROSOFT_TENANT=common
# Where the browser reaches this API. The Next.js app proxies /api/v1, so this
# is the frontend origin by default.
OAUTH_PUBLIC_BASE_URL=http://localhost:3000
# Where users land after signing in.
FRONTEND_URL=http://localhost:3000
